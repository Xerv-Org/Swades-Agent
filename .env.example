API_KEY=sk-or-v1-your-key-here
BASE_URL=https://openrouter.ai/api/v1
MODEL=openrouter/free

# Fallback models for automatic failover on rate limits (429), payment errors (402), etc.
# Comma-separated list of OpenRouter model IDs tried in order when the primary model fails.
# Example: FALLBACK_MODELS=nousresearch/deephermes-3-llama-3-8b-preview:free,deepseek/deepseek-chat-v3-0324:free
FALLBACK_MODELS=
